{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "type:dependencies"
  ],
  "schedule": [
    "after 11pm every weekend",
    "before 8am every weekend"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "matchManagers": [
        "npm"
      ],
      "minimumReleaseAge": "14 days",
      "internalChecksFilter": "strict",
      "addLabels": [
        "package:npm"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "package:github-actions"
      ]
    },
    {
      "groupName": "Dockerfile",
      "matchManagers": [
        "docker"
      ],
      "addLabels": [
        "package:docker"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": false,
      "addLabels": [
        "update:minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": false,
      "addLabels": [
        "status:ready-to-merge"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "update:major"
      ]
    },
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "automerge": false,
      "addLabels": [
        "update:misc"
      ]
    },
    {
      "groupName": "eslint packages",
      "matchPackageNames": [
        "/.*eslint.*/"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "definitelyTyped packages",
      "matchPackageNames": [
        "@types/**"
      ],
      "minimumReleaseAge": "14 days"
    }
  ]
}
