{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json, env.d.ts",
    "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .prettier*, prettier*, .editorconfig, bun*, renovate.json, .mergify.yml, .browserslistrc, trivy.yaml",
    ".gitignore": ".git*",
    ".env.example": ".env*",
    "Dockerfile": ".dockerignore, docker-compose.yml, nginx.conf",
    "README.md": "CHANGELOG.md, CONTRIBUTING.md, LICENSE"
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "source.fixAll.biome": "explicit",
    "source.fixAll": "explicit"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "npm.packageManager": "pnpm",
  "biome.configurationPath": "biome.json"
}
